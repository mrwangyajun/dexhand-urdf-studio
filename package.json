{
  "name": "dexhand-urdf-studio",
  "private": true,
  "version": "0.1.0",
  "description": "浏览器里分件赋参、在线拼装、一键导出灵巧手 URDF（纯前端，无后端）",
  "type": "module",
  "license": "MIT",
  "author": "dexhand-urdf-studio contributors",
  "keywords": [
    "urdf",
    "robotics",
    "dexterous-hand",
    "threejs",
    "solidworks",
    "ros2",
    "inertia",
    "mass-properties",
    "cad"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrwangyajun/dexhand-urdf-studio.git"
  },
  "bugs": {
    "url": "https://github.com/mrwangyajun/dexhand-urdf-studio/issues"
  },
  "homepage": "https://github.com/mrwangyajun/dexhand-urdf-studio#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "samples": "node scripts/gen-samples.mjs",
    "selftest": "node scripts/selftest.mjs",
    "verify": "node scripts/verify-export.mjs",
    "e2e": "node scripts/e2e.mjs",
    "layout": "node scripts/layout-check.mjs",
    "examples": "node scripts/make-examples.mjs",
    "shots": "node scripts/shots.mjs",
    "test": "node scripts/selftest.mjs && node scripts/verify-export.mjs",
    "ci": "node scripts/selftest.mjs && node scripts/verify-export.mjs && vite build"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
